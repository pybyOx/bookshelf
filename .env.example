# Шаблон переменных окружения. Скопируй в .env и подставь свои значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore) — это твои реальные секреты.

# Секретный ключ Django. Сгенерировать новый:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True — только для локальной разработки. В production ДОЛЖНО быть False.
DEBUG=True

# Домены через запятую, по которым сайту разрешено отвечать.
ALLOWED_HOSTS=localhost,127.0.0.1

# Адрес базы данных (PostgreSQL). Локально можно не задавать —
# тогда проект использует SQLite. На Render сюда придёт адрес Postgres.
# DATABASE_URL=postgres://user:password@host:5432/dbname
